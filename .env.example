# EDEN Refinery — public build flags only. No secrets in this app.
# Copy values into Vercel → Settings → Environment Variables
# (Production and Preview). Do not commit a filled .env.

# Canonical origin used in <link rel="canonical"> and share URLs.
VITE_SITE_URL=https://edenrefinery.com

# Accounts are off. Must remain false for this deployment.
VITE_AUTH_ENABLED=false

# Do not set:
# DATABASE_URL=
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=
